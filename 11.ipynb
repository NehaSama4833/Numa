import numpy as np
import matplotlib.pyplot as plt
np.random.seed(42)
goal = 15                                   # states 0..15, goal = bottom-right

def step(state, action):                    # 0=up 1=right 2=down 3=left
    row, col = divmod(state, 4)
    if action == 0: row = max(row - 1, 0)
    elif action == 1: col = min(col + 1, 3)
    elif action == 2: row = min(row + 1, 3)
    else: col = max(col - 1, 0)
    next_state = row * 4 + col
    if next_state == goal:
        return next_state, 10, True         # reached goal: +10
    return next_state, -1, False            # every other step: -1

def train(epsilon, episodes=1000, alpha=0.1, gamma=0.9):
    Q = np.zeros((16, 4))
    rewards = []
    for _ in range(episodes):
        state, total = 0, 0
        for _ in range(100):
            if np.random.rand() < epsilon:
                action = np.random.randint(4)     # explore
            else:
                action = np.argmax(Q[state])      # exploit
            next_state, reward, done = step(state, action)
            target = reward if done else reward + gamma * np.max(Q[next_state])
            Q[state, action] += alpha * (target - Q[state, action])    # update rule
            state, total = next_state, total + reward
            if done:
                break
        rewards.append(total)
    return Q, rewards

for eps in [0.5, 0.1, 0.01]:
    Q, rewards = train(eps)
    print("epsilon", eps, "| avg reward (last 100):", round(np.mean(rewards[-100:]), 2))
    plt.plot(np.convolve(rewards, np.ones(50) / 50, mode="valid"), label="eps " + str(eps))
plt.legend()
plt.show()

Q, _ = train(0.1)
state, path = 0, [0]
while state != goal and len(path) < 20:
    state, _, _ = step(state, np.argmax(Q[state]))
    path.append(state)
print("Optimal path:", path, "| steps:", len(path) - 1)
